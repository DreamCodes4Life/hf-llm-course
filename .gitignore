# Python virtual environment (created with: python3 -m venv .env)
.env/
.venv/

# Secrets — keep tokens out of a public repo
*.env
.secrets*
hf_token*

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/

# Training outputs, checkpoints and downloaded data (large; rebuild them instead)
outputs/
checkpoints/
runs/
wandb/
models/
data/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf

# Symlink to the virtual environment on the SSD
.env

# Practice-exam questions from paid prep sites (e.g. Preporato) — copyrighted, keep them local only
exam-questions/
exam-questions*.md
exam-questions*.json
